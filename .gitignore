# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/

# PyCharm settings
.idea/

# Other files you don’t want to track
*.log
*.sqlite3

# Runtime / test artifacts
images/
incoming/
output/

# Camera captures
*.jpg
*.png
*.jpeg
*.rar
*.zip
*.7z

!recipes/**/*.jpg
!recipes/**/*.jpeg
!recipes/**/*.png

# Shipped VG VISTA branding (the broad camera-capture rule above ignores PNGs).
!hmi_app/qml/assets/**/*.png
!hmi_app/qml/assets/**/*.ico

# Local Windows packaging output.
build/
dist/
