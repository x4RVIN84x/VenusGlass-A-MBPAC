# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/

# PyCharm settings
.idea/

# Other files you don’t want to track
*.log
*.sqlite3

# Runtime / test artifacts
images/
incoming/
output/

# Camera captures
*.jpg
*.png
*.jpeg
*.rar
*.zip
*.7z

# Product definitions must remain self-contained after a clone.  Golden images
# are calibration assets, not disposable camera captures.
!recipes/**/*.jpg
!recipes/**/*.jpeg
!recipes/**/*.png

!recipes/**/*.jpg
!recipes/**/*.jpeg
!recipes/**/*.png
